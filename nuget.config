<?xml version="1.0" encoding="utf-8"?>
<!--
  Pins package restore to nuget.org and nothing else.

  Without this file, restore inherits whatever sources the machine happens to
  have configured. On the author's machine that included a private corporate
  feed, which NuGet warned about (NU1507) because with several sources and no
  mapping it is free to resolve a package from any of them.

  That is dependency confusion: a package published to a private feed under the
  name of a public one can be picked up in place of the real thing. Every
  dependency here is public, so there is nothing to gain from an extra source
  and something to lose from one.

  It also makes restore reproducible. A contributor's build, the author's build,
  and the CI build now read from the same place, rather than differing by
  whatever is in each developer's global configuration.
-->
<configuration>

  <!-- clear discards any source inherited from a machine or user level
       configuration file. Without it the entries below are added to those
       sources rather than replacing them, which would defeat the purpose. -->
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>

  <packageSourceMapping>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>

</configuration>
