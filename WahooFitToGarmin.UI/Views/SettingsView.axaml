<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:WahooFitToGarmin.UI.ViewModels"
             x:Class="WahooFitToGarmin.UI.Views.SettingsView"
             x:DataType="vm:SettingsViewModel">

  <ScrollViewer>
    <StackPanel Margin="16" Spacing="20" MaxWidth="720" HorizontalAlignment="Left">

      <TextBlock Text="Appearance" FontSize="18" FontWeight="SemiBold" />
      <StackPanel Spacing="6">
        <TextBlock Text="Theme" />
        <ComboBox ItemsSource="{Binding Themes}"
                  SelectedItem="{Binding SelectedTheme}"
                  MinWidth="200" />
        <TextBlock Text="Default follows your operating system."
                   Opacity="0.7" FontSize="12" />
      </StackPanel>

      <TextBlock Text="Watched folder" FontSize="18" FontWeight="SemiBold" />
      <StackPanel Spacing="6">
        <TextBlock Text="Activity files dropped here are uploaded automatically." Opacity="0.7" FontSize="12" />
        <StackPanel Orientation="Horizontal" Spacing="8">
          <TextBox Text="{Binding WatchedFolder, Mode=OneWay}" IsReadOnly="True" MinWidth="460" />
          <Button Content="Choose…" Command="{Binding SelectFolderCommand}" />
        </StackPanel>
        <CheckBox Content="Keep the file after it has been uploaded"
                  IsChecked="{Binding KeepUploadedActivityFile}" />
      </StackPanel>

      <TextBlock Text="Device emulation" FontSize="18" FontWeight="SemiBold" />
      <StackPanel Spacing="8">
        <CheckBox Content="Present activities as recorded by a Garmin device"
                  IsChecked="{Binding EmulateDevice}" />

        <ComboBox ItemsSource="{Binding Devices}"
                  SelectedItem="{Binding SelectedDevice}"
                  IsEnabled="{Binding EmulateDevice}"
                  MinWidth="280">
          <ComboBox.ItemTemplate>
            <DataTemplate>
              <TextBlock Text="{Binding DisplayName}" />
            </DataTemplate>
          </ComboBox.ItemTemplate>
        </ComboBox>

        <!-- The honest limits, next to the setting rather than buried in the
             documentation. Exercise load was observed; recovery time was not,
             and claiming otherwise would generate disappointed reports. -->
        <TextBlock TextWrapping="Wrap" Opacity="0.7" FontSize="12" MaxWidth="560">
          Only the manufacturer and model recorded in the file are changed. Your ride,
          its timing, and your sensors are left exactly as recorded.
        </TextBlock>
        <TextBlock TextWrapping="Wrap" Opacity="0.7" FontSize="12" MaxWidth="560">
          Garmin Connect has been observed to credit an exercise load for an activity
          uploaded this way, and to list the selected model as the recording device.
          Recovery time is a separate matter: your watch computes it from recent
          training, so it depends on Garmin's own processing and on your device
          syncing afterwards. It is not something this setting can guarantee.
        </TextBlock>
      </StackPanel>

      <TextBlock Text="Garmin Connect" FontSize="18" FontWeight="SemiBold" />
      <StackPanel Spacing="6">
        <TextBlock Text="Email" />
        <TextBox Text="{Binding GarminLogin}" MinWidth="360" />
        <TextBlock Text="Password" />
        <TextBox Text="{Binding GarminPassword}" PasswordChar="•" MinWidth="360" />
      </StackPanel>

      <TextBlock Text="About" FontSize="18" FontWeight="SemiBold" />
      <StackPanel Spacing="6">
        <TextBlock Text="{Binding Version, StringFormat='Version {0}'}" />
        <Button Content="Open the project page" Command="{Binding OpenProjectPageCommand}" />
      </StackPanel>

    </StackPanel>
  </ScrollViewer>
</UserControl>
