<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:WahooFitToGarmin.UI.ViewModels"
        x:Class="WahooFitToGarmin.UI.Views.ShellWindow"
        x:DataType="vm:ShellViewModel"
        Title="Wahoo Fit To Garmin"
        Icon="/Assets/garmin-wahoo-logo.ico"
        Width="900" Height="600"
        MinWidth="640" MinHeight="420">

  <Grid ColumnDefinitions="Auto,*">

    <Border Grid.Column="0" Padding="8" Width="180"
            Background="{DynamicResource SystemControlBackgroundListLowBrush}">
      <StackPanel Spacing="4">
        <Button Content="Activity" Command="{Binding ShowMainCommand}"
                HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" />
        <Button Content="Settings" Command="{Binding ShowSettingsCommand}"
                HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" />
        <Button Content="Back" Command="{Binding GoBackCommand}"
                HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                Margin="0,12,0,0" />
      </StackPanel>
    </Border>

    <ContentControl Grid.Column="1" Content="{Binding Current}" />

  </Grid>
</Window>
